* { font-family: @font_ui@; font-size: 13px; color: @text@; }
QMainWindow, QWidget { background-color: @bg@; }
QLabel { background-color: transparent; }
QToolTip { background-color: @surface2@; color: @text@; border: 1px solid @border@; padding: 4px 6px; }

/* ---- header / navigation ---- */
#AppHeader { background-color: @surface@; border-bottom: 1px solid @border@; }
#AppTitle { font-size: 15px; font-weight: 700; background: transparent; }
#AppSub { color: @muted@; font-size: 12px; background: transparent; }
#NavButton { background: transparent; border: none; border-bottom: 2px solid transparent;
             border-radius: 0; padding: 14px 16px; color: @muted@; font-weight: 600; }
#NavButton:hover { color: @text@; }
#NavButton:checked { color: @accent@; border-bottom: 2px solid @accent@; }

/* ---- text roles ---- */
#Muted { color: @muted@; background: transparent; }
#Heading { font-size: 17px; font-weight: 700; background: transparent; }
#SubHeading { font-size: 13px; font-weight: 700; color: @accent@; background: transparent; }
#Mono { font-family: @font_mono@; background: transparent; }
#MonoBlock { font-family: @font_mono@; background-color: @surface@; border: 1px solid @border@;
             border-radius: 8px; padding: 10px 12px; }
#BigMono { font-family: @font_mono@; font-size: 22px; font-weight: 700; color: @accent@;
           background-color: @surface@; border: 1px solid @border@; border-radius: 10px; padding: 14px 18px; }
#Chip { background-color: @surface2@; border: 1px solid @border@; border-radius: 12px;
        padding: 3px 11px; font-family: @font_mono@; }
#InfoStrip { background-color: @surface@; border: 1px solid @border@; border-radius: 8px; padding: 6px 10px; color: @muted@; }
#Card { background-color: @surface@; border: 1px solid @border@; border-radius: 10px; }

/* ---- buttons / inputs ---- */
QPushButton { padding: 8px 16px; border-radius: 7px; border: 1px solid @border@;
              background-color: @surface2@; font-weight: 600; }
QPushButton:hover { border-color: @muted@; }
QPushButton:focus { border: 1px solid @accent@; }
#PrimaryButton:focus { border: 2px solid @text@; }
QPushButton:disabled { color: #6B7688; background-color: @surface@; border-color: @border@; }
#PrimaryButton { background-color: @accent@; color: @accent_text@; border: none; }
#PrimaryButton:hover { background-color: @accent_hover@; }
#PrimaryButton:disabled { background-color: @accent_bg@; color: #8C7B4E; }
#ToolButton { padding: 3px 10px; font-size: 12px; }
QLineEdit, QPlainTextEdit { background-color: @surface@; border: 1px solid @border@; border-radius: 7px;
                            padding: 8px 10px; selection-background-color: @accent@;
                            selection-color: @accent_text@; placeholder-text-color: #7D889A; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 1px solid @accent@; }
#IdInput { font-family: @font_mono@; font-size: 17px; letter-spacing: 1px; padding: 9px 12px; }
QComboBox { background-color: @surface2@; border: 1px solid @border@; border-radius: 7px; padding: 7px 10px; }
QComboBox QAbstractItemView { background-color: @surface2@; selection-background-color: @accent_bg@;
                              selection-color: @text@; border: 1px solid @border@; }

/* ---- tape (input ribbon) ---- */
#TapeFrame { background-color: @surface@; border: 1px solid @border@; border-radius: 10px; }
#TapeCell { font-family: @font_mono@; font-size: 15px; font-weight: 700; border-radius: 6px;
            border: 1px solid @border@; background-color: @surface2@; color: @text@; }
#TapeCell[cell="done"] { background-color: @accent_bg@; border: 1px solid @accent@; color: @accent@; }
#TapeCell[cell="active"] { background-color: @accent@; border: 1px solid @accent@; color: @accent_text@; }
#TapeCell[cell="error"], #TapeCell[cell="illegal"] { background-color: @bad_bg@; border: 2px solid @bad@; color: @bad@; }
#TapeCell[cell="final"] { background-color: @ok_bg@; border: 1px solid @ok@; color: @ok@; }
#TapeInner, #TapeViewport, #TapeFrame QScrollArea { background: transparent; border: none; }
#TapeSeg { min-height: 3px; max-height: 3px; border-radius: 1px; background: transparent; }
#TapeSeg[seg="a"] { background-color: @seg_a@; }
#TapeSeg[seg="b"] { background-color: @seg_b@; }
#TapeIndex { color: @muted@; font-size: 10px; font-family: @font_mono@; }

/* ---- verdict banner ---- */
#Banner { background-color: @surface@; border: 1px solid @border@; border-radius: 10px; }
#BannerTitle { font-size: 22px; font-weight: 800; letter-spacing: 1px; background: transparent; }
#BannerText { background: transparent; color: @text@; }
#Banner[state="accepted"] { background-color: @ok_bg@; border: 1px solid @ok@; }
#Banner[state="accepted"] #BannerTitle { color: @ok@; }
#Banner[state="rejected"] { background-color: @bad_bg@; border: 1px solid @bad@; }
#Banner[state="rejected"] #BannerTitle { color: @bad@; }
#Banner[state="running"] #BannerTitle { color: @accent@; }
#Banner[state="idle"] #BannerTitle { color: @muted@; }

/* ---- tables / tabs / splitters ---- */
QTableWidget { background-color: @surface@; border: 1px solid @border@; border-radius: 8px;
               gridline-color: @border@; alternate-background-color: @surface@; }
QTableWidget::item { padding: 3px 6px; }
QTableWidget::item:selected { background-color: @accent_bg@; color: @text@; }
QHeaderView::section { background-color: @surface2@; color: @muted@; padding: 6px; border: none;
                       border-bottom: 1px solid @border@; font-weight: 700; }
QTabWidget::pane { border: none; border-top: 1px solid @border@; }
QTabBar::tab { background: transparent; color: @muted@; padding: 9px 14px; border: none;
               border-bottom: 2px solid transparent; font-weight: 600; }
QTabBar::tab:hover { color: @text@; }
QTabBar::tab:selected { color: @accent@; border-bottom: 2px solid @accent@; }
QSplitter::handle { background-color: @border@; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSlider::groove:horizontal { height: 4px; background: @border@; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @accent@; border-radius: 2px; }
QSlider::handle:horizontal { background: @text@; width: 14px; margin: -6px 0; border-radius: 7px; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: @border@; border-radius: 5px; min-height: 24px; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: @border@; border-radius: 5px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollArea { border: none; }
